{
	# Internal only: no public DNS, no public certificate.
	auto_https off
}

# Applications live on the console's host, under /apps/<name>.
#
# Why not a subdomain: `__Host-at_session` is host-bound, so a cookie set for
# console.agent-tools.internal is never sent to durable.agent-tools.internal and
# forward_auth would always 401. Keeping the same host (different port is irrelevant to
# cookies) makes forward_auth work without a Domain cookie that every subdomain could read.
https://console.agent-tools.internal {
	tls internal

	handle_path /apps/durable-pi/* {
		# Strip client-supplied identity BEFORE forward_auth adds its own.
		request_header -X-AT-User
		request_header -X-AT-Username
		request_header -X-AT-Roles

		forward_auth platform:8444 {
			uri /authz?app=durable-pi
			copy_headers X-AT-User X-AT-Username X-AT-Roles
		}

		reverse_proxy durable-pi:4781
	}

	respond "Not found" 404
}
