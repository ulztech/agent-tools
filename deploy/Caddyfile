{
	# Internal only: no public DNS, no public certificate.
	auto_https off
}

https://durable.agent-tools.internal {
	tls internal

	# Strip any client-supplied identity header BEFORE forward_auth adds its own.
	# Without this, a client can forge X-AT-User — the classic forward-auth mistake.
	request_header -X-AT-User
	request_header -X-AT-Username
	request_header -X-AT-Roles

	# The control plane's authz listener answers on authz-net only.
	forward_auth platform:8444 {
		uri /authz?app=durable-pi
		copy_headers X-AT-User X-AT-Username X-AT-Roles
	}

	reverse_proxy durable-pi:4781

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
